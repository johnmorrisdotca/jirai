{
  "name": "@johnmorrisdotca/jirai",
  "version": "0.4.2",
  "description": "Minesweeper on square, orthogonal, hexagonal and wraparound boards: four levels up to extra-hard, seeded games, a safe opening, verified no-guess boards, explained hints and a playable board for any page. Zero runtime dependencies.",
  "type": "module",
  "license": "MIT",
  "author": "John Morris",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnmorrisdotca/jirai.git"
  },
  "homepage": "https://johnmorrisdotca.github.io/jirai/",
  "bugs": {
    "url": "https://github.com/johnmorrisdotca/jirai/issues"
  },
  "keywords": [
    "minesweeper",
    "mines",
    "minefield",
    "logic-puzzle",
    "deduction-puzzle",
    "number-clues",
    "hexagonal-minesweeper",
    "hex-grid",
    "orthogonal-minesweeper",
    "four-neighbour",
    "four-neighbor",
    "eight-neighbour",
    "eight-neighbor",
    "wraparound-grid",
    "no-guess",
    "no-guess-minesweeper",
    "difficulty-levels",
    "seeded-puzzle",
    "daily-puzzle",
    "puzzle-generator",
    "puzzle-solver",
    "typescript",
    "javascript",
    "svg",
    "accessible",
    "keyboard",
    "touch",
    "web-component",
    "custom-element",
    "react-component",
    "zero-dependencies",
    "board-game",
    "logic-game",
    "grid-game"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./orthogonal": {
      "types": "./dist/orthogonal.d.ts",
      "import": "./dist/orthogonal.js",
      "default": "./dist/orthogonal.js"
    },
    "./play": {
      "types": "./dist/play-entry.d.ts",
      "import": "./dist/play-entry.js",
      "default": "./dist/play-entry.js"
    },
    "./draw": {
      "types": "./dist/draw-entry.d.ts",
      "import": "./dist/draw-entry.js",
      "default": "./dist/draw-entry.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js",
      "default": "./dist/element.js"
    },
    "./element/define": {
      "types": "./dist/element-define.d.ts",
      "import": "./dist/element-define.js",
      "default": "./dist/element-define.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    }
  },
  "sideEffects": [
    "./dist/element-define.js"
  ],
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:presentation",
    "site": "pnpm build && node scripts/site.mjs",
    "test:demo": "pnpm site && playwright test",
    "test:package": "pnpm build && node scripts/check-package.mjs",
    "prepublishOnly": "pnpm check && pnpm test:package",
    "check:presentation": "node scripts/check-presentation.mjs",
    "screenshots:readme": "pnpm site && node scripts/readme-pictures.mjs",
    "test:readme": "pnpm build && node scripts/check-readme-examples.mjs"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.11.0"
}
